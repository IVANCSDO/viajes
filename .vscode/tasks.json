{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Escocia: servidor local",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "py",
        "args": ["-3", "-u", "scripts/serve.py"]
      },
      "args": ["-u", "scripts/serve.py"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "escocia-server",
        "pattern": {
          "regexp": "^(.*):(\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^ESCOCIA_SERVER_START$",
          "endsPattern": "^ESCOCIA_SERVER_READY "
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
